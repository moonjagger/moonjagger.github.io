---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
  <!-- 自定义：站点运行时间 + 访问统计（继承自原 Hexo 站） -->
  <div
    class="flex flex-col items-center gap-0.5 pb-6 text-xs text-base-content opacity-60"
  >
    <span>
      <span id="timeDate">🚀 已持续运行 <span id="timeDateDays">0</span> 天</span>
      <span id="busuanzi_container_site_pv" style="display: none">
        &nbsp;|&nbsp;浏览次数 <span id="busuanzi_value_site_pv"></span> 次
      </span>
      <span id="busuanzi_container_site_uv" style="display: none">
        &nbsp;|&nbsp;浏览人数 <span id="busuanzi_value_site_uv"></span> 人
      </span>
    </span>
  </div>
</footer>

<script is:inline data-astro-rerun>
  // 建站纪念：2024-08-26 起持续运行（每次导航重新执行，避免定时器累积）
  const startDate = new Date("08/26/2024 00:00:00");
  const daysEl = document.getElementById("timeDateDays");
  function createtime() {
    if (!daysEl) return;
    const diff = (Date.now() - startDate.getTime()) / 1000;
    if (diff < 0) return;
    daysEl.textContent = String(Math.floor(diff / 86400));
  }
  createtime();
  setInterval(createtime, 60000);
</script>
<script is:inline data-astro-rerun>
  // busuanzi 统计：兼容 Astro View Transitions（每次导航后重新执行）
  (function () {
    const pvEl = document.getElementById("busuanzi_value_site_pv");
    const uvEl = document.getElementById("busuanzi_value_site_uv");
    const pvBox = document.getElementById("busuanzi_container_site_pv");
    const uvBox = document.getElementById("busuanzi_container_site_uv");
    if (!pvEl || !uvEl || !pvBox || !uvBox) return;
    const cb =
      "BusuanziCallback_" + Math.floor(1099511627776 * Math.random());
    window[cb] = function (data) {
      delete window[cb];
      if (!data) return;
      if (data.site_pv != null) {
        pvEl.textContent = data.site_pv;
        pvBox.style.display = "inline";
      }
      if (data.site_uv != null) {
        uvEl.textContent = data.site_uv;
        uvBox.style.display = "inline";
      }
    };
    const s = document.createElement("script");
    s.src = "https://busuanzi.ibruce.info/busuanzi?jsonpCallback=" + cb;
    s.onerror = function () {
      delete window[cb];
    };
    document.head.appendChild(s);
  })();
</script>
